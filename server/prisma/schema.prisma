generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  password     String
  name         String
  company      String?
  role         String       @default("engineer") // engineer | admin
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  projects     Project[]
  settings     UserSettings?

  @@map("users")
}

model Project {
  id           String        @id @default(cuid())
  name         String
  client       String?
  engineer     String
  projectNo    String?
  revision     String        @default("A")
  date         String?
  companyName  String?
  description  String?
  status       String        @default("active") // active | archived | completed
  userId       String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  calculations Calculation[]

  @@map("projects")
}

model Calculation {
  id          String   @id @default(cuid())
  projectId   String
  type        String   // cable-current | voltage-drop | short-circuit | etc.
  title       String
  inputs      String   // JSON
  results     String   // JSON
  notes       String?
  standard    String?
  tags        String?  // comma-separated
  revision    String   @default("A")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("calculations")
}

model UserSettings {
  id           String  @id @default(cuid())
  userId       String  @unique
  theme        String  @default("dark")
  unitSystem   String  @default("metric")
  standard     String  @default("IEC")
  companyName  String?
  engineerName String?
  logoUrl      String?
  autoSave     Boolean @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String   // created | updated | deleted | exported
  resource  String   // project | calculation | settings
  resourceId String?
  details   String?  // JSON
  ip        String?
  createdAt DateTime @default(now())

  @@map("audit_logs")
}
